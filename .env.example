# ==============================================================================
# Akidha Marketing OS — Script Properties & Environment Configuration
# ==============================================================================
# Configure these in Google Apps Script > Project Settings > Script Properties
# or in local staging environments.

# 1. DATABASE CONFIGURATION (Required)
# Google Spreadsheet ID created via setupDatabase()
SPREADSHEET_ID=your_google_spreadsheet_id_here

# 2. ROLE-BASED ACCESS CONTROL (Required)
# Comma-separated Google account emails
ADMIN_EMAILS=sourabh.suryavanshi@akidha.in,tanvi@akidha.in
CONTRIBUTOR_EMAILS=nikita@akidha.in,sai@akidha.in

# 3. AI CREATIVE STUDIO CREDENTIALS (Optional for AI Generation)
# Provider selection: 'gemini' or 'openai'
AI_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 4. GITHUB CI/CD SECRETS (For automated deployments)
# CLASPRC_JSON: JSON token from ~/.clasprc.json
# STAGING_SCRIPT_ID: Apps Script ID for staging
# PROD_SCRIPT_ID: Apps Script ID for production (1O99gBpy9s5gzV2FfsAFP_IVXU1yX7XlH-mqVpDohN610ZJs0xxOzlVyd)

